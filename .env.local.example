# Claude API (https://console.anthropic.com/settings/keys 에서 발급)
ANTHROPIC_API_KEY=

# Supabase (https://supabase.com 에서 새 프로젝트 생성 후 Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kakao Link JS SDK (https://developers.kakao.com/console/app 에서 앱 생성 후
# 앱 설정 > 앱 키 > JavaScript 키, 그리고 플랫폼에 사이트 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Supabase service role key (Project Settings > API > service_role / secret)
# 서버 라우트 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트 코드에서 쓰지 말 것
SUPABASE_SERVICE_ROLE_KEY=
